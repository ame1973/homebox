{
  "name": "@homebox/web",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.contracts.json --pretty false",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --coverage",
    "test:build": "node --test tests/build-budget.test.mjs",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/schema.d.ts --alphabetize --immutable",
    "api:check": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/schema.d.ts --alphabetize --immutable --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.68.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.89.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
